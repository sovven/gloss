{
  "manifest_version": 3,
  "name": "Gloss",
  "version": "2.4.1",
  "description": "Gloss：在原文下方显示译文的双语对照阅读插件。只翻译正文，支持 Google、微软和 AI 翻译。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://www.bing.com/*",
    "https://cn.bing.com/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Gloss (Alt+Q)"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-page": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "翻译此网页 / 显示原文"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true
    }
  ]
}
