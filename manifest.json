{
  "manifest_version": 3,
  "name": "沉浸式双语翻译",
  "version": "2.3.0",
  "description": "仿沉浸式翻译：整页双语对照、仅译文模式、悬停翻译段落、划词翻译，支持 Google / 微软 / AI 翻译",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://www.bing.com/*",
    "https://cn.bing.com/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "沉浸式双语翻译 (Alt+Q)"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-page": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "翻译此网页 / 显示原文"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true
    }
  ]
}
